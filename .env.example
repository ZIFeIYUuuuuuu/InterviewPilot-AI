# InterviewPilot AI local environment template.
# Copy this file to .env and fill secrets locally. Do not commit .env.

INTERVIEWPILOT_ENV=local
INTERVIEWPILOT_HOST=127.0.0.1
INTERVIEWPILOT_PORT=8000
INTERVIEWPILOT_RELOAD=false
INTERVIEWPILOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional LLM provider. Leave API key empty to use the local deterministic MVP engine.
INTERVIEWPILOT_LLM_ENABLED=true
INTERVIEWPILOT_LLM_API_KEY=
INTERVIEWPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTERVIEWPILOT_LLM_MODEL=qwen-plus
INTERVIEWPILOT_LLM_TIMEOUT_SECONDS=30

# Optional voice providers. Browser speech fallback works without keys.
# Set this to aliyun if you want the interview page to default to cloud TTS.
# Users can also choose 阿里云百炼语音 from the interview setup screen.
INTERVIEWPILOT_VOICE_PROVIDER=browser
# Aliyun Model Studio / DashScope TTS can reuse INTERVIEWPILOT_LLM_API_KEY or DASHSCOPE_API_KEY.
INTERVIEWPILOT_ALIYUN_VOICE_API_KEY=
INTERVIEWPILOT_ALIYUN_VOICE_MODEL=cosyvoice-v3-flash
INTERVIEWPILOT_ALIYUN_VOICE_TIMEOUT_SECONDS=12
# Built-in Aliyun voice parameters by interviewer persona.
INTERVIEWPILOT_ALIYUN_WARM_VOICE_ID=longanxuan_v3
INTERVIEWPILOT_ALIYUN_TECHNICAL_VOICE_ID=longshuo_v3
INTERVIEWPILOT_ALIYUN_PRESSURE_VOICE_ID=longfei_v3
INTERVIEWPILOT_DOUBAO_VOICE_API_KEY=
INTERVIEWPILOT_DOUBAO_VOICE_APP_ID=

# Optional local persistence path.
INTERVIEWPILOT_STORE_PATH=data/interviewpilot_store.json

# Optional local OCR data for scanned/image-only resume PDFs.
# The backend auto-detects ./data/tessdata when present.
INTERVIEWPILOT_TESSDATA_PREFIX=data/tessdata
